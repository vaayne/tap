# Remote CDP endpoint (optional, uses local Chrome if unset)
# Accepts either a browser WebSocket URL or an HTTP DevTools base URL.
# TAP_WS_URL=ws://127.0.0.1:9222/devtools/browser/abc
# TAP_WS_URL=http://127.0.0.1:9222

# Chrome profile directory (optional, defaults to ~/.cache/tap/chrome-profile-$USER)
# TAP_PROFILE_DIR=

# Sites directory (optional, defaults to ./sites)
# TAP_SITES_DIR=./sites
