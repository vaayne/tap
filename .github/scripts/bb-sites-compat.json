{
  "version": 1,
  "scripts": {
    "hackernews/thread": {
      "match": {
        "domain": "news.ycombinator.com"
      },
      "set": {
        "executionDomain": "hacker-news.firebaseio.com",
        "startPath": "/v0/topstories.json"
      }
    },
    "hackernews/top": {
      "match": {
        "domain": "news.ycombinator.com"
      },
      "set": {
        "executionDomain": "hacker-news.firebaseio.com",
        "startPath": "/v0/topstories.json"
      }
    }
  }
}
